generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Schema originally written for SQLite (no native enums/scalar lists), now on
// Postgres via Supabase. Kept the same String-based encoding rather than
// switching to native enums/arrays, since it already works on both engines.
// String columns constrained by TS union types + Zod (src/lib/generation/types.ts,
// src/lib/validation). JSON payloads are serialized into String columns.

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  // Step [AUTH] (docs/V2-MULTI-TENANT-AUTH.md). "solo" = auto-created personal
  // workspace behind a solo signup; "team" = everything else, including every
  // Organization that existed before this field was added (see migration
  // backfill note on OrganizationMember below). Informational only — never an
  // authorization signal by itself, membership is what RLS/app code check.
  workspaceType           String                   @default("team") // solo | team
  ownerUserId             String?
  owner                   User?                    @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Renamed relation (was `users`) now that User.organizationId -> homeOrganizationId:
  // this is "users whose home/default workspace is this org," not "members of
  // this org" — membership (including users whose home org is elsewhere) lives
  // in OrganizationMember below.
  homeUsers               User[]                   @relation("OrganizationHomeUsers")
  members                 OrganizationMember[]
  teams                   Team[]
  initiatives             Initiative[]
  integrationConnections  IntegrationConnection[]
  dashboardConfigurations DashboardConfiguration[]
  aiUsageEvents           AiUsageEvent[]
  aiRequestLocks          AiRequestLock[]
  createdAt               DateTime                 @default(now())
}

model User {
  id                       String               @id @default(cuid())
  // Step [AUTH]. Bridges to Supabase Auth's auth.users.id. Nullable until the
  // one-time backfill (docs/V2-MULTI-TENANT-AUTH.md) links every existing User
  // row to a real auth.users row; required for every row created afterward.
  // Deliberately NOT the primary key: User.id (cuid) is already referenced by
  // 7+ other tables' FKs, and existing ids aren't valid UUID text, so bridging
  // via a separate column is additive and leaves every existing FK untouched.
  authUserId               String?              @unique @db.Uuid
  // Renamed from `organizationId`: this is now the user's *default* workspace,
  // not their only one — see OrganizationMember for actual (possibly
  // multi-org) membership. @map keeps the underlying column name unchanged
  // (no data migration needed) while forcing every direct Prisma read of the
  // old field name to fail to compile, so each call site gets an explicit,
  // reviewed decision: "home org" or "resolved active org" (getCurrentUser()).
  homeOrganizationId       String               @map("organizationId")
  homeOrganization         Organization         @relation("OrganizationHomeUsers", fields: [homeOrganizationId], references: [id])
  ownedOrganizations       Organization[]       @relation("OrganizationOwner")
  memberships              OrganizationMember[]
  name                     String
  email                    String               @unique
  // Step 8B (docs/V2-USERS-TEAMS.md). String + default, matching this schema's
  // existing convention (e.g. Initiative.status) rather than a native enum.
  // Default "org_admin" is deliberate: today there is exactly one User per
  // Organization (the demo user, who already has unrestricted control), so
  // backfilling to "standard_user" would migrate every existing single-user
  // org into a zero-admin state — the one state the Step 8B safeguards
  // explicitly exist to prevent. New invited users must set this explicitly
  // (typically "standard_user"), not rely on the column default.
  // Step [AUTH]: this column is now a fallback/seed value only. The
  // authoritative, per-organization permission role is OrganizationMember.role
  // (owner|admin|member) — getCurrentUser() derives this field fresh each
  // request from the resolved active org's membership row, so existing
  // `accessLevel === "org_admin"` checks throughout the codebase keep working
  // unchanged. New code should read OrganizationMember.role directly.
  accessLevel              String               @default("org_admin") // standard_user | org_admin
  // Nullable, no default, deliberately: Working Role has lived only in the
  // Step 4 onboarding cookie (src/lib/onboarding/tempStateServer.ts) and there
  // is no truthful value to backfill an existing User row with. Populated
  // naturally as a user completes/updates onboarding — see docs/V2-USERS-TEAMS.md
  // "Auth Transition" for the read-persisted-fall-back-to-cookie strategy.
  workingRole              String? // product_management | project_manager | product_owner
  memberType               String               @default("internal") // internal | external
  status                   String               @default("active") // active | disabled | archived
  // AES-256-GCM ciphertext (src/lib/security/secretBox.ts), never the raw key —
  // used only for this user's own document-import requests, never shared
  // across accounts. updatedAt tracks rotation, not read for anything else.
  anthropicApiKeyEncrypted String?
  anthropicApiKeyUpdatedAt DateTime?
  profiles                 QualifyingProfile[]
  initiatives              Initiative[]
  teamMemberships          TeamMember[]
  initiativeAccess         InitiativeAccess[]
  aiUsageEvents            AiUsageEvent[]
  aiRequestLocks           AiRequestLock[]
  intakeAiAnalyses         IntakeAiAnalysis[]
  createdAt                DateTime             @default(now())
}

// Step [AUTH] (docs/V2-MULTI-TENANT-AUTH.md). Real multi-org membership: one
// person can belong to more than one Organization, with a different `role` in
// each — the thing User.homeOrganizationId alone can no longer express. Named
// OrganizationMember (not the brief's literal "organization_members") to match
// this schema's existing PascalCase-model / TeamMember-style convention.
// Related on `authUserId` (not User.id) so it lines up directly with
// auth.uid() for RLS helper functions with no extra join.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authUserId     String       @db.Uuid
  user           User         @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  status         String       @default("active") // active | disabled
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, authUserId])
  @@index([authUserId])
}

// Step 8B (docs/V2-USERS-TEAMS.md, docs/V2-ORG-ADMIN-IA.md §6-7). Flat — no
// nested teams, no team roles (deliberate MVP scope per
// docs/V2-ACCESS-TEAMS-VISIBILITY.md §3). No status/archive field: nothing in
// the approved admin workflow archives a team, only deletes one.
model Team {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  name             String
  description      String             @default("")
  members          TeamMember[]
  initiativeAccess InitiativeAccess[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Join model, User <-> Team. Unique on (teamId, userId) blocks duplicate
// membership at the database level, not just in application code (the
// "duplicate direct grant" edge case in docs/V2-ORG-ADMIN-IA.md §20 applies
// the same principle to InitiativeAccess in Step 8C). Cascades on delete in
// both directions so removing a team or a user never leaves an orphaned
// membership row — matches the cascade pattern already used throughout this
// schema (e.g. IntakeAnswerSet -> Initiative).
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

// Step 8C (docs/V2-RESOURCE-ACCESS.md). One shared grant table for both direct
// and team grants, per docs/V2-ACCESS-TEAMS-VISIBILITY.md §17 (explicitly
// rejected: separate UserInitiativeAccess/TeamInitiativeAccess tables). Every
// row's grantee is exactly one of userId/teamId — enforced at the app layer
// (src/lib/access/mutations.ts) plus a database CHECK constraint added by hand
// to this migration (Prisma's schema DSL has no @@check primitive). The two
// partial-unique indexes below rely on Postgres treating NULL as distinct per
// row, so a teamId-only row never collides with a userId-only row on the same
// initiative, and each real grantee can still only appear once.
model InitiativeAccess {
  id           String     @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  permission   String // owner | edit | view
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([initiativeId, userId])
  @@unique([initiativeId, teamId])
}

model QualifyingProfile {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  role              String // senior_pm | product_owner | business_analyst | project_manager | scrum_master | founder_first_timer | executive_stakeholder
  experienceLevel   String // first_time | some_experience | experienced | expert
  teamComposition   String // solo | small_team | multiple_teams
  productType       String // software_product | non_product  (FR-02 gate)
  executionTool     String // jira | azure_devops | aha | other | none
  statedMethodology String       @default("hybrid") // hybrid | agile_scrum | waterfall | kanban | not_sure
  isProductWork     Boolean      @default(true)
  initiatives       Initiative[]
  createdAt         DateTime     @default(now())
}

model Initiative {
  id                      String                   @id @default(cuid())
  organizationId          String
  organization            Organization             @relation(fields: [organizationId], references: [id])
  userId                  String
  user                    User                     @relation(fields: [userId], references: [id])
  qualifyingProfileId     String?
  qualifyingProfile       QualifyingProfile?       @relation(fields: [qualifyingProfileId], references: [id])
  name                    String
  description             String                   @default("")
  methodology             String                   @default("hybrid")
  status                  String                   @default("draft") // draft | intake_in_progress | generated
  targetLaunchDate        DateTime? // optional, from initiative creation
  budget                  Float? // optional available budget (Planning & Cost Logic §24)
  averageHourlyRate       Float?                   @default(85) // §17/§31 prototype assumption, user-overridable
  intakeAnswerSet         IntakeAnswerSet?
  prototype               Prototype?
  syncConnections         SyncConnection[]
  integrationConnections  IntegrationConnection[]
  initiativeAccess        InitiativeAccess[]
  aiUsageEvents           AiUsageEvent[]
  aiRequestLocks          AiRequestLock[]
  intakeAiAnalyses        IntakeAiAnalysis[]
  planningWeightOverrides PlanningWeightOverride[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model IntakeAnswerSet {
  id                         String       @id @default(cuid())
  initiativeId               String       @unique
  initiative                 Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  problemStatement           String       @default("") // Q1
  targetCustomer             String       @default("") // Q2
  outcomeStatement           String       @default("") // Q3
  outcomeMetric              String       @default("") // Q3 optional metric
  teamSize                   Int? // Q7
  sprintLengthWeeks          Int          @default(2) // Q7
  velocityPerPersonPerSprint Float        @default(8) // Q7 legacy points model (superseded by hours model when present)
  capacityBufferPercent      Int          @default(15) // Q7 (§31 default)
  hoursPerSprintPerMember    Float        @default(80) // §10 hours available per member per sprint
  utilizationRatePercent     Int          @default(70) // §10/§31 prototype assumption
  hoursPerStoryPoint         Float        @default(8) // §12/§31 prototype assumption
  historicalVelocityPoints   Float? // §13 optional — replaces estimated conversion when known
  status                     String       @default("draft") // draft | generated
  validatedAt                DateTime?
  capabilities               Capability[]
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

model Capability {
  id                      String                 @id @default(cuid())
  intakeAnswerSetId       String
  intakeAnswerSet         IntakeAnswerSet        @relation(fields: [intakeAnswerSetId], references: [id], onDelete: Cascade)
  name                    String
  description             String                 @default("")
  isMvp                   Boolean // Q4
  effortSize              String // Q6: xs | s | m | l | xl
  businessValue           String // Q8: very_low | low | medium | high | critical (§2 five-level scale)
  riskLevel               String                 @default("medium") // §4: low | medium | high | critical
  mvpImportance           String? // §5 optional override: required_for_mvp | strongly_preferred | useful_not_required | future_enhancement | optional (derived from isMvp when null)
  manualPhaseOverride     Int? // Timeline drag-and-drop override (1/2/3); null = computed by partitionPhases. Ignored by partitionPhasesContinuousBacklog (agile_scrum).
  customerImpactScore     Int? // §2 optional weighted sub-factors, each 1-5
  revenueImpactScore      Int?
  strategicAlignmentScore Int?
  riskComplianceScore     Int?
  businessValueScore      Float? // §2 computed weighted score, snapshotted only when sub-factors are used
  order                   Int                    @default(0)
  dependsOnEdges          CapabilityDependency[] @relation("FromCapability")
  dependedOnBy            CapabilityDependency[] @relation("ToCapability")
  artifacts               ArtifactLayer[]
  createdAt               DateTime               @default(now())
}

model CapabilityDependency {
  id               String     @id @default(cuid())
  fromCapabilityId String // this capability...
  fromCapability   Capability @relation("FromCapability", fields: [fromCapabilityId], references: [id], onDelete: Cascade)
  toCapabilityId   String // ...depends on this one (must come first)
  toCapability     Capability @relation("ToCapability", fields: [toCapabilityId], references: [id], onDelete: Cascade)
  note             String     @default("") // Q5 free text

  @@unique([fromCapabilityId, toCapabilityId])
}

model Prototype {
  id                   String          @id @default(cuid())
  initiativeId         String          @unique
  initiative           Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  status               String          @default("active")
  approvedBaselineJson String? // FR-13 snapshot, serialized JSON
  approvedAt           DateTime?
  layers               ArtifactLayer[]
  sprints              Sprint[]
  releases             Release[]
  layerLocks           LayerLock[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

// One row per strict waterfall layer type. Locking is coarse-grained: the whole
// layer locks/unlocks, matching "each layer locks before the next begins" (FR-12).
model LayerLock {
  id          String    @id @default(cuid())
  prototypeId String
  prototype   Prototype @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  layerType   String // roadmap | feature_hierarchy | epics | stories | acceptance_criteria
  sequence    Int // 1..5
  state       String    @default("unlocked") // unlocked | locked
  everLocked  Boolean   @default(false)
  lockedAt    DateTime?

  @@unique([prototypeId, layerType])
}

model ArtifactLayer {
  id                 String          @id @default(cuid())
  prototypeId        String
  prototype          Prototype       @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  type               String // roadmap | roadmap_phase | feature | epic | story | acceptance_criterion
  parentId           String?
  parent             ArtifactLayer?  @relation("LayerChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children           ArtifactLayer[] @relation("LayerChildren")
  order              Int             @default(0)
  title              String
  body               String          @default("")
  contentJson        String          @default("{}") // type-specific payload, serialized JSON
  points             Int? // stories only
  sourceCapabilityId String?
  sourceCapability   Capability?     @relation(fields: [sourceCapabilityId], references: [id])
  traceAnswerKeys    String          @default("") // comma-separated subset of q1..q8 (FR-10)
  traceNote          String          @default("")
  sprintId           String? // stories only
  sprint             Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  externalRef        String? // fake Jira key once "synced" (stub)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([prototypeId, type])
  @@index([parentId])
}

model Sprint {
  id             String          @id @default(cuid())
  prototypeId    String
  prototype      Prototype       @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  sprintNumber   Int
  phaseNumber    Int
  startDate      DateTime
  endDate        DateTime
  capacityPoints Float
  releaseId      String?
  release        Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  stories        ArtifactLayer[]
  createdAt      DateTime        @default(now())

  @@unique([prototypeId, sprintNumber])
}

model Release {
  id          String    @id @default(cuid())
  prototypeId String
  prototype   Prototype @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  name        String // "Release 1 (MVP)" ...
  phaseNumber Int
  targetDate  DateTime
  order       Int
  sprints     Sprint[]
  createdAt   DateTime  @default(now())

  @@unique([prototypeId, order])
}

// Jira only — Aha!/Azure DevOps intentionally not modeled (out of scope).
model SyncConnection {
  id             String     @id @default(cuid())
  initiativeId   String
  initiative     Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  tool           String     @default("jira")
  status         String     @default("not_connected") // not_connected | connected
  connectedAt    DateTime?
  lastSyncedAt   DateTime?
  fakeProjectKey String?
  createdAt      DateTime   @default(now())

  @@unique([initiativeId, tool])
}

// ---------- Integrations Hub (Demo Mode) — Product platform spec §2.7 ----------
// Generic provider registry; coexists deliberately with the legacy Jira-only
// SyncConnection above (which the workspace JiraSyncPanel still uses).

model IntegrationProvider {
  id                     String                  @id @default(cuid())
  key                    String                  @unique // jira | aha | azure_devops | confluence | notion | slack | figma | github
  name                   String
  category               String // execution | documentation | design | communication | source_control | roadmap
  description            String                  @default("")
  logoPath               String                  @default("")
  previewImagePath       String                  @default("")
  statusDefault          String                  @default("available")
  isActive               Boolean                 @default(true)
  isFeatured             Boolean                 @default(false)
  supportsDemoConnection Boolean                 @default(true)
  supportsSync           Boolean                 @default(true)
  supportsImport         Boolean                 @default(false)
  supportsExport         Boolean                 @default(false)
  displayOrder           Int                     @default(0)
  capabilities           IntegrationCapability[]
  connections            IntegrationConnection[]
  createdAt              DateTime                @default(now())
}

model IntegrationConnection {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  initiativeId       String? // nullable = org-wide connection
  initiative         Initiative?          @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  providerId         String
  provider           IntegrationProvider  @relation(fields: [providerId], references: [id])
  connectionName     String               @default("")
  status             String               @default("available") // available | needs_configuration | demo_connected | sync_ready | sync_complete | demo_error
  mode               String               @default("demo") // demo | live_future
  workspaceName      String?
  workspaceUrl       String?
  projectKey         String?
  projectName        String?
  configuredByUserId String?
  configuredAt       DateTime?
  lastSyncAt         DateTime?
  lastSyncStatus     String?
  lastSyncMessage    String?
  isEnabled          Boolean              @default(true)
  settingsJson       String               @default("{}")
  syncLogs           IntegrationSyncLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([organizationId, providerId, initiativeId])
}

model IntegrationCapability {
  id                 String              @id @default(cuid())
  providerId         String
  provider           IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  capabilityKey      String
  capabilityLabel    String
  description        String              @default("")
  isEnabledByDefault Boolean             @default(true)

  @@unique([providerId, capabilityKey])
}

model IntegrationSyncLog {
  id             String                @id @default(cuid())
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncType       String // e.g. push_stories | push_epics | preview_mapping
  status         String // success | error
  itemsProcessed Int                   @default(0)
  message        String                @default("")
  startedAt      DateTime              @default(now())
  finishedAt     DateTime?
  detailsJson    String                @default("{}")
}

// Step 8E (docs/V2-DASHBOARD-CONFIGURATION.md). Presentation only — never an
// authorization signal (docs/V2-STANDARD-DASHBOARD.md §8/§9,
// docs/V2-ACCESS-TEAMS-VISIBILITY.md §13/§18). Deliberately no userId, no
// teamId, no permission level: this table controls which already-authorized
// Standard Dashboard widgets render, never what data a user may reach.
// widgetId is validated in application code against
// src/lib/dashboard/widgetRegistry.ts's DASHBOARD_WIDGETS, not enforced by a
// database constraint (same "String + app-level validation" convention this
// schema already uses throughout, e.g. Initiative.status).
model DashboardConfiguration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workingRole    String // product_management | project_manager | developer
  widgetId       String // must match a DASHBOARD_WIDGETS id
  visible        Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, workingRole, widgetId])
}

// Explicit Planning Rules / Explainable Scoring foundations. Initiative-scoped
// (not org-scoped, unlike DashboardConfiguration) so "appropriate experience
// or permissions" can be checked against that initiative's own
// QualifyingProfile.experienceLevel and InitiativeAccess — see
// src/lib/planningWeights/permissions.ts. Stores a WHOLE weight set per row
// (never a per-factor sparse override, unlike DashboardConfiguration's
// per-widget rows): weights must sum to ~1.0, and a partial override could
// silently break that invariant. weightSetId/weightsJson are validated in
// application code against src/lib/planningWeights/weightRegistry.ts, not
// enforced by a database constraint (same convention as DashboardConfiguration
// above). No new numeric default is introduced anywhere by this table — an
// initiative that never customizes a set has zero rows and falls through to
// the code-level defaults (VALUE_FACTOR_WEIGHTS / PRIORITY_WEIGHTS).
model PlanningWeightOverride {
  id           String     @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  weightSetId  String // valueFactorWeights | priorityWeights
  weightsJson  String // serialized Record<string, number>; all keys present, sums to ~1.0
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([initiativeId, weightSetId])
}

// ---------- AI Foundation (docs/V2-AI-FOUNDATION.md) ----------
// Server-side only: every call uses the server ANTHROPIC_API_KEY env var,
// never a value exposed to the client. Deliberately separate from
// User.anthropicApiKeyEncrypted above, which stays dedicated to the
// existing per-user intake-document-import feature (src/lib/intakeImport) —
// that flow is untouched by this section.

model AiCapability {
  id                       String   @id @default(cuid())
  action                   String   @unique // AiActionKey, e.g. "ANALYZE_INTAKE"
  enabled                  Boolean  @default(true)
  maxOutputTokens          Int      @default(4096)
  userMonthlyLimit         Int      @default(50)
  organizationMonthlyLimit Int      @default(500)
  description              String   @default("")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// One row per finished AI attempt (never "processing" — see AiRequestLock
// for the in-flight marker), so usage history and limit-counting queries
// never need to filter out in-progress rows.
model AiUsageEvent {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  initiativeId   String?
  initiative     Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  action         String // AiActionKey
  success        Boolean
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  errorMessage   String?
  createdAt      DateTime     @default(now())

  @@index([userId, action, createdAt])
  @@index([organizationId, action, createdAt])
}

// Ephemeral duplicate-request guard. scopeKey is the initiativeId for an
// initiative-scoped action (so two users triggering the same initiative's
// analysis at once are serialized, not just double-clicks from one user),
// else the userId for a future user-scoped action. The unique constraint is
// the actual dedup mechanism (correct across concurrent serverless
// invocations); a row older than a few minutes is treated as abandoned by
// application code and cleared before retry.
model AiRequestLock {
  id             String       @id @default(cuid())
  scopeKey       String
  action         String
  userId         String
  organizationId String
  initiativeId   String?
  startedAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  initiative     Initiative?  @relation(fields: [initiativeId], references: [id])

  @@unique([scopeKey, action])
}

// Validated ANALYZE_INTAKE output. Additive-only alongside IntakeAnswerSet/
// Capability — never written to by anything that also writes those tables,
// so an AI analysis can never overwrite original user-entered intake data.
// JSON payloads serialized into String columns, matching this schema's
// existing convention (see header comment).
model IntakeAiAnalysis {
  id                     String     @id @default(cuid())
  initiativeId           String
  initiative             Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  generatedByUserId      String
  generatedByUser        User       @relation(fields: [generatedByUserId], references: [id])
  summary                String
  assumptionsJson        String // JSON string[]
  missingInformationJson String // JSON string[]
  risksJson              String // JSON array of {description, severity}
  recommendedPhasesJson  String // JSON array of {name, description, relatedCapabilities[]}
  rationale              String
  modelUsed              String
  createdAt              DateTime   @default(now())

  @@index([initiativeId, createdAt])
}
